# ==========================================================
# 🔴 MarsBoard - Variables de Entorno de Producción
# ==========================================================

# ─── BACKEND ───
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://marsboard.iotsoluciones.cloud

# NASA API Key (Copia este archivo a .env.production y coloca tu key real)
NASA_API_KEY=tu_api_key_de_nasa_aqui

# ─── FRONTEND ───
NEXT_PUBLIC_API_URL=/api
